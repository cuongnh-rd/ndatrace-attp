<mxfile><diagram name="LC-01 — Luồng thay thế và ngoại lệ"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Cán bộ tiêu chuẩn" style="swimlane;horizontal=0;html=1;startSize=150;fillColor=#CFD8DC;swimlaneFillColor=#E3F2FD;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="2425" height="140" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;horizontal=0;html=1;startSize=150;fillColor=#CFD8DC;swimlaneFillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="0" y="180" width="2425" height="140" as="geometry"/></mxCell><mxCell id="s" value="Đang ở một bước cấu hình" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="192.5" y="87.0" width="120" height="46" as="geometry"/></mxCell><mxCell id="d1" value="Loại = Chế biến?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#F57F17;" vertex="1" parent="1"><mxGeometry x="398.5" y="210.0" width="118" height="80" as="geometry"/></mxCell><mxCell id="h1" value="Bỏ qua bước 3; mở thông tin lô cho đầu ra" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="587.5" y="218.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="c1" value="Quay lại đổi bước nghiệp vụ" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="792.5" y="78.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="h2" value="Tính lại hành động, trạng thái gợi ý; đánh dấu cần xác nhận lại" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="792.5" y="218.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="c2" value="Nhấn Lưu nháp / Tiếp tục" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="997.5" y="78.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="d2" value="Có lỗi?" style="rhombus;whiteSpace