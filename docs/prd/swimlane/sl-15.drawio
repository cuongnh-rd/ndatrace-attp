<mxfile><diagram name="LC-08 — Phê duyệt và công bố (luồng chính)"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="lane0" value="Lãnh đạo phê duyệt" style="swimlane;horizontal=0;html=1;startSize=150;fillColor=#CFD8DC;swimlaneFillColor=#FFF3E0;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="2220" height="140" as="geometry"/></mxCell><mxCell id="lane1" value="Hệ thống" style="swimlane;horizontal=0;html=1;startSize=150;fillColor=#CFD8DC;swimlaneFillColor=#F5F5F5;" vertex="1" parent="1"><mxGeometry x="0" y="180" width="2220" height="140" as="geometry"/></mxCell><mxCell id="lane2" value="Nền tảng quốc gia (Cấp 1)" style="swimlane;horizontal=0;html=1;startSize=150;fillColor=#CFD8DC;swimlaneFillColor=#E8F5E9;" vertex="1" parent="1"><mxGeometry x="0" y="320" width="2220" height="140" as="geometry"/></mxCell><mxCell id="lane3" value="Cấp 3, Cấp 4, địa phương kế thừa" style="swimlane;horizontal=0;html=1;startSize=150;fillColor=#CFD8DC;swimlaneFillColor=#F3E5F5;" vertex="1" parent="1"><mxGeometry x="0" y="460" width="2220" height="140" as="geometry"/></mxCell><mxCell id="s" value="Mở bản Chờ phê duyệt" style="ellipse;whiteSpace=wrap;html=1;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="192.5" y="87.0" width="120" height="46" as="geometry"/></mxCell><mxCell id="h1" value="Hiển thị bản trình, bảng thay đổi, kết quả kiểm tra" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="382.5" y="218.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="l1" value="Xem; giữ hoặc chỉnh ngày áp dụng; nhấn Phê duyệt" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="587.5" y="78.0" width="150" height="64" as="geometry"/></mxCell><mxCell id="h2" value="Chạy lại kiểm tra tổng thể" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1565C0;" vertex="1" parent="1"><mxGeometry x="792.5" y="218.0" width="150" height="64" as="geometry"/